@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 0 0% 2%;
    --foreground: 0 0% 98%;
    --card: 0 0% 4%;
    --card-foreground: 0 0% 98%;
    --popover: 0 0% 4%;
    --popover-foreground: 0 0% 98%;
    --primary: 0 84% 60%;
    --primary-foreground: 0 0% 100%;
    --secondary: 0 0% 9%;
    --secondary-foreground: 0 0% 98%;
    --muted: 0 0% 12%;
    --muted-foreground: 0 0% 63%;
    --accent: 0 0% 14%;
    --accent-foreground: 0 84% 70%;
    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 98%;
    --border: 0 0% 15%;
    --input: 0 0% 15%;
    --ring: 0 84% 60%;
    --radius: 0rem;
    --font-mono:
      "Geist Mono", ui-monospace, SFMono-Regular, "Roboto Mono", Menlo, Monaco, "Liberation Mono", "DejaVu Sans Mono", "Courier New", monospace, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
  }
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
    font-family: var(--font-mono);
    padding-top: 4rem; /* 64px, matches the header height */
    background:
      radial-gradient(circle at 18% 18%, hsl(var(--primary) / 5%), transparent 28rem),
      radial-gradient(circle at 82% 8%, hsl(0 0% 100% / 3%), transparent 26rem),
      hsl(var(--background));
    background-attachment: fixed;
  }

  @media (pointer: fine) {
    html.custom-cursor-ready body,
    html.custom-cursor-ready a,
    html.custom-cursor-ready button,
    html.custom-cursor-ready input,
    html.custom-cursor-ready textarea {
      cursor: none;
    }
  }
}

.writing-vertical-rl {
  writing-mode: vertical-rl;
}

.surveillance-hero {
  isolation: isolate;
  background: transparent;
}

.surveillance-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -25;
  background:
    linear-gradient(hsl(0 0% 100% / 0.015) 1px, transparent 1px),
    radial-gradient(circle at center, transparent 0 48%, black 100%);
  background-size: 100% 3px, auto;
  pointer-events: none;
}
